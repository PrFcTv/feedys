# Feedys — variables d’environnement
# ⛔ Ce fichier est suivi par git et le dépôt est PUBLIC.
#    Aucune valeur réelle ici, jamais. Les vraies vont dans .env.local.

DATABASE_URL="postgresql://feedys:feedys@localhost:5432/feedys"

# L’origine réellement servie — sert à composer les liens des emails
FEEDYS_URL_PUBLIQUE="http://localhost:3000"

# Le modèle. Explicite, jamais un défaut implicite : il est journalisé
# dans chaque synthèse, sans quoi une régression de qualité est inexplicable.
ANTHROPIC_API_KEY=""
FEEDYS_MODELE="claude-sonnet-5"

# L’envoi de la note
SMTP_URL=""
FEEDYS_EMAIL_DE="feedys@exemple.fr"
FEEDYS_EMAIL_A="dev@exemple.fr"

# Captures et audio — un volume monté en production
FEEDYS_STOCKAGE="./.stockage"

# Accès au back-office — une seule personne, un mot de passe, une session.
# Le changer invalide toutes les sessions ouvertes (01-Specs/back-office.md).
FEEDYS_BO_MOT_DE_PASSE=""

# La version déployée, affichée en pied de back-office avec le lien vers la
# source — article 13 de l’AGPL. Posée à la construction de l’image (P-013) ;
# absente sur un poste, où « dev » est la réponse honnête.
FEEDYS_VERSION=""

# Chiffre le secret des produits en base — 32 octets en base64url.
# C’est elle qui permet de vérifier l’identité signée par l’hôte (D-015).
# En générer une :
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
FEEDYS_CLE_CHIFFREMENT=""

# Jeton du serveur MCP
FEEDYS_MCP_JETON=""

# Le rôle qui MIGRE — le propriétaire des tables.
#
# ⚠️ Facultative. Sans elle, on migre avec DATABASE_URL : c’est le cas d’un
#    poste et de la CI, qui n’ont qu’un rôle.
#
# ⛔ En production les deux DOIVENT différer : DATABASE_URL sert avec un rôle
#    membre de feedys_app, celle-ci migre avec le propriétaire. Un propriétaire
#    qui sert contourne tous les GRANT, et rien ne le signalerait.
#    Procédure : 04-Architecture/hebergement.md §Le rôle de connexion.
DATABASE_URL_MIGRATIONS=""
